# Copie este arquivo para .streamlit/secrets.toml (localmente, se quiser
# testar a senha antes do deploy) e troque o valor abaixo.
#
# No Streamlit Community Cloud, NÃO se sobe esse arquivo — a mesma chave é
# colada em: painel do app → Settings → Secrets.
#
# Sem essa chave configurada, o app abre sem pedir senha (uso local no
# escritório).

senha_acesso = "troque-esta-senha"
